classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +Optional[time] scheduled_time
        +str frequency
        +str notes
        +bool completed
        +mark_complete() None
        +priority_rank() int
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list[str] medical_notes
        +list[Task] tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +add_medical_note(note: str) None
        +pending_tasks() list[Task]
    }

    class Owner {
        +str name
        +int available_minutes
        +dict[str, str] preferences
        +list[Pet] pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Optional[Pet]
        +all_tasks() list[tuple[Pet, Task]]
    }

    class Organizer {
        +Owner owner
        +date plan_date
        +list[tuple[Pet, Task]] plan
        +list[tuple[Pet, Task]] skipped
        +sort_tasks(tasks: list[tuple[Pet, Task]]) list[tuple[Pet, Task]]
        +generate_plan() list[tuple[Pet, Task]]
        +explain_plan() str
        +summary_by_pet() dict[str, list[Task]]
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Organizer "1" --> "1" Owner : plans for
    Organizer ..> Task : schedules
